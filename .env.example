# 复制为 .env 后按需修改，docker compose 会自动读取
# 默认值与 application.yml / docker-compose.yml 保持一致（刻意不同的地方有注释）

# 数据库：应用使用独立账号，不直接用 root
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=mojian
MYSQL_USER=mojian
MYSQL_PASSWORD=mojian123

# 模型接入（也可以启动后在「模型接入」页配置，优先级更高）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 注意：LLM_MOCK=true 时即使填了上面的 Key 也会走演示模式；要接真实模型必须改成 false
LLM_MOCK=true

# 可选 Redis 任务锁（application.yml 里默认关闭）
REDIS_HOST=localhost
REDIS_PORT=6379

# Agent 最大步数（默认 10）
AGENT_MAX_STEPS=10
